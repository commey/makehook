# Server Configuration
PORT=5000
FLASK_ENV=development

# Security: Shared secret checked via header 'X-MakeHook-Secret'
# If left blank, security header validation will be bypassed (for local testing).
MAKEHOOK_SECRET=your_makehook_secret_here

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional: Point to custom OpenAI-compatible endpoint (LiteLLM, Azure, Ollama)
# OPENAI_BASE_URL=http://localhost:4000/v1
